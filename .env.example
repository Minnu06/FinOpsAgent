# Copy this file to .env and fill in the values you need.
# .env is gitignored — never commit real keys.

# --- LLM backend ---------------------------------------------------------
# "openai" (default, most reliable for tool-call routing) or "ollama" (fully local)
LLM_PROVIDER=openai

# --- OpenAI (required when LLM_PROVIDER=openai) ---------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Ollama (used when LLM_PROVIDER=ollama) --------------------------------
# Requires a local Ollama server (https://ollama.com) with a tool-calling
# capable model pulled, e.g.: ollama pull llama3.1
OLLAMA_MODEL=llama3.1
